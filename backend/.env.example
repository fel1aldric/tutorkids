# Database
MYSQL_USER=tutorkids
MYSQL_PASSWORD=tutorkids_password
MYSQL_DATABASE=tutorkids
MYSQL_HOST=localhost
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://tutorkids:tutorkids_password@localhost:3306/tutorkids

# LLM / Ollama (free, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b-cloud

# TTS (free, local)
TTS_PROVIDER=pyttsx3
TTS_VOICE=fr_FR-siwis-medium

# STT (free, local)
STT_PROVIDER=whisper

# App
APP_SECRET_KEY=change-me-in-production-very-long-secret-key
APP_ENV=development


# Webhook de production n8n (le workflow doit être Active). En test : /webhook-test/...
N8N_WEBHOOK_URL=http://localhost:5678/webhook/tutorkids-notify
# Même secret des deux côtés : openssl rand -hex 32
INTERNAL_API_KEY=change-me
REMINDER_LEAD_MINUTES=30