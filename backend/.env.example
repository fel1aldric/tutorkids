# Database
MYSQL_USER=tutorkids
MYSQL_PASSWORD=tutorkids_password
MYSQL_DATABASE=tutorkids
MYSQL_HOST=localhost
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://tutorkids:tutorkids_password@localhost:3306/tutorkids

# LLM / Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# TTS
TTS_PROVIDER=piper
TTS_VOICE=fr_FR-siwis-medium

# STT
STT_PROVIDER=whisper

# App
APP_SECRET_KEY=change-me-in-production-very-long-secret-key
APP_ENV=development
